.{
    .name = .niobium_hello,
    .version = "1.0.0",
    .fingerprint = 0xab5f1ed12aed6f98, // Changing this has security and trust implications.
    .minimum_zig_version = "0.17.0",
    .dependencies = .{
        // A product repository uses a URL + hash here (docs/development/consuming.md).
        .niobium = .{ .path = "../.." },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "app",
        "components",
        "product.json",
        "branding.json",
    },
}
